# Copy this file to .env; `npm run server` loads it with --env-file-if-exists.
# The interface exposes no secret to its bundle.

# Configuration file the service reads and writes. In the image it is mounted
# at /config/blackbox.yml, which is also the default. The service runs the HTTP
# and NTLM checks itself; no exporter process is needed.
CONFIG_FILE=/config/blackbox.yml

# Port the file service listens on. It is the only port the image publishes.
PORT=9115

# Probe-mode resources. `true` or `false` in any case; any other value stops the
# service at startup and names the variable. Both are off by default. /probe
# always answers on a read-only mount; /metrics and /history need their switch.
CHECKER_METRICS_ENABLED=false
CHECKER_HISTORY_ENABLED=false
